---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts } from '../../lib/posts';
import { SITE } from '../../lib/site';
import { collectionPageSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const PER_PAGE = 10;
  const posts = await getSortedPosts();
  return SITE.categories.map((category) => {
    const items = posts.filter(
      (p) =>
        p.data.category === category.name ||
        p.data.categories.includes(category.name),
    );
    return {
      params: { category: category.slug },
      props: {
        name: category.name,
        slug: category.slug,
        items: items.slice(0, PER_PAGE),
      },
    };
  });
}

const { name, slug, items } = Astro.props;
const url = `${SITE.url}/category/${slug}/`;
---

<BaseLayout
  title={`${name} Archives - ${SITE.title}`}
  jsonLd={[
    collectionPageSchema(`${name} Archives`, url),
    breadcrumbSchema([
      { name: SITE.title, url: `${SITE.url}/` },
      { name: name, url },
    ]),
  ]}
>
  <h1 class="archive-title wide">{name}</h1>
  <div class="post-grid wide archive">
    {items.map((post) => <PostCard post={post} showDate showMore={false} />)}
  </div>
</BaseLayout>
