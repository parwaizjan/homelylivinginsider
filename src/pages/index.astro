---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getSortedPosts, excerptFromBody } from '../lib/posts';
import { SITE, POSTS_PER_PAGE } from '../lib/site';
import { websiteSchema } from '../lib/schema';

const posts = await getSortedPosts();
const [hero, ...rest] = posts;
const grid = rest.slice(0, POSTS_PER_PAGE);
const hasOlder = rest.length > POSTS_PER_PAGE;
---

<BaseLayout
  title={`${SITE.title} - ${SITE.tagline}`}
  description={SITE.tagline}
  jsonLd={websiteSchema()}
>
  <section class="home-intro container">
    <h1>{SITE.title}</h1>
    <p>{SITE.tagline}</p>
  </section>

  {
    hero && (
      <article class="home-hero wide">
        <div class="home-hero__media">
          <a href={`/${hero.id}/`} tabindex="-1" aria-hidden="true">
            {hero.data.featuredImage && (
              <img
                src={hero.data.featuredImage}
                alt={hero.data.featuredImageAlt ?? ''}
                fetchpriority="high"
                decoding="async"
              />
            )}
          </a>
        </div>
        <div class="home-hero__body">
          <h2 class="home-hero__title">
            <a href={`/${hero.id}/`}>{hero.data.title}</a>
          </h2>
          <p>{excerptFromBody(hero.body)}</p>
          <p class="post-card__more">
            <a href={`/${hero.id}/`}>Read More</a>
          </p>
        </div>
      </article>
    )
  }

  <div class="wide">
    <hr class="section-divider" />
    <h2 class="section-heading">Latest Posts</h2>
  </div>

  <div class="post-grid wide">
    {grid.map((post) => <PostCard post={post} />)}
  </div>

  {
    hasOlder && (
      <nav class="pagination wide" aria-label="Posts navigation">
        <span class="pagination__spacer" />
        <a href="/page/2/">Older Posts →</a>
      </nav>
    )
  }
</BaseLayout>
