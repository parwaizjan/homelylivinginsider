---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
---

<BaseLayout title={`Page Not Found - ${SITE.title}`} noindex>
  <div class="container" style="margin-block: var(--sp-50); text-align: center;">
    <h1>Page not found</h1>
    <p style="margin-top: var(--block-gap);">
      The page you are looking for does not exist. <a href="/">Return home</a>.
    </p>
  </div>
</BaseLayout>
